meta {
  name: Reset Password
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/v1/auth/password/reset
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "{{reset_token}}",
    "new_password": "{{new_password}}"
  }
}

settings {
  encodeUrl: false
}
