meta {
  name: Change Password
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/v1/auth/password/change
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "current_password": "{{password}}",
    "new_password": "{{new_password}}"
  }
}

settings {
  encodeUrl: false
}
