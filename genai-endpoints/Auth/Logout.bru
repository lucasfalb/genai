meta {
  name: Logout
  type: http
  seq: 11
}

post {
  url: {{base_url}}/api/v1/auth/logout
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refresh_token": "{{refresh_token}}"
  }
}

settings {
  encodeUrl: false
}
