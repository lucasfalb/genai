meta {
  name: Update Link
  type: http
  seq: 3
}

patch {
  url: {{base_url}}/api/v1/tenant/instances/{{instance_id}}/links/{{link_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Content-Type: application/json
  X-Tenant-ID: {{tenant_id}}
}

body:json {
  {
    "trigger_description": "Use when the user asks about invoices, payments, or refunds.",
    "transfer_mode": "router_classifier",
    "is_enabled": true
  }
}

settings {
  encodeUrl: false
}
