meta {
  name: Create Link
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/tenant/instances/{{instance_id}}/links
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Content-Type: application/json
  X-Tenant-ID: {{tenant_id}}
}

body:json {
  {
    "target_instance_id": "{{target_instance_id}}",
    "transfer_tool_name": "transfer_to_billing",
    "trigger_description": "Use when the user needs billing or payment help.",
    "transfer_mode": "llm_decision",
    "is_enabled": true
  }
}

settings {
  encodeUrl: false
}
