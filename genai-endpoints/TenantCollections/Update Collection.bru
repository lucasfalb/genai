meta {
  name: Update Collection
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/api/v1/tenant/collections/{{collection_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Content-Type: application/json
  X-Tenant-ID: {{tenant_id}}
}

body:json {
  {
    "name": "Legal Archive v2",
    "description": "Updated description."
  }
}

settings {
  encodeUrl: false
}
