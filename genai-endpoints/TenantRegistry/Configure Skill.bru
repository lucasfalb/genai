meta {
  name: Configure Skill
  type: http
  seq: 2
}

put {
  url: {{base_url}}/api/v1/registry/instances/{{instance_id}}/skills/{{skill_slug}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Tenant-ID: {{tenant_id}}
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "is_enabled": true,
    "config": {
      "max_results": 5
    }
  }
}

settings {
  encodeUrl: false
}
