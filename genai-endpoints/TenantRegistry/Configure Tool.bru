meta {
  name: Configure Tool
  type: http
  seq: 3
}

put {
  url: {{base_url}}/api/v1/registry/instances/{{instance_id}}/tools/{{tool_slug}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Tenant-ID: {{tenant_id}}
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "is_enabled": true,
    "config": {
      "timeout_seconds": 20
    }
  }
}

settings {
  encodeUrl: false
}
