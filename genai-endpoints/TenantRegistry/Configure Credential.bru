meta {
  name: Configure Credential
  type: http
  seq: 5
}

put {
  url: {{base_url}}/api/v1/registry/credentials/{{skill_slug}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Tenant-ID: {{tenant_id}}
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "secret_ref": "{{secret_ref}}",
    "metadata": {
      "provider": "example"
    }
  }
}

settings {
  encodeUrl: false
}
